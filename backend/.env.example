# Sertão.Unimontes - Configurações de Ambiente
DEBUG=True
SECRET_KEY=sertao-unimontes-django-insecure-secret-key-2026-unimontes-norte-de-minas
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# CORS Origins
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Banco de Dados (PostgreSQL em produção; se vazio, fallback automático para SQLite)
DATABASE_URL=sqlite:///db.sqlite3

# Throttling
DEFAULT_THROTTLE_RATE_ANON=60/min
DEFAULT_THROTTLE_RATE_USER=300/min
ORCHESTRATOR_THROTTLE_RATE=20/min

# Upload & Payload Security
MAX_PAYLOAD_SIZE_BYTES=8388608

# LLM Fallback Keys (Opcionais)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=
