# ==============================================================================
# Projeto Sertão.Unimontes — Variáveis de Ambiente Globais (.env.example)
# Copie este arquivo para backend/.env e frontend/.env conforme necessário.
# ==============================================================================

# --- BACKEND (Django) ---
DEBUG=True
SECRET_KEY=sua-chave-secreta-do-django-aqui
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0
CORS_ALLOWED_ORIGINS=http://localhost:5500,http://127.0.0.1:5500,http://localhost:5173
DATABASE_URL=sqlite:///db.sqlite3
DEFAULT_THROTTLE_RATE_ANON=60/min
DEFAULT_THROTTLE_RATE_USER=300/min
MAX_PAYLOAD_SIZE_BYTES=8388608

# Chaves de IA (Opcionais)
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
OPENAI_API_KEY=

# --- FRONTEND (Vite / React) ---
VITE_API_URL=/api
VITE_BACKEND_URL=http://localhost:8000
VITE_PORT=5500
